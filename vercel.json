{
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend,data,frontend/dist}/**",
      "excludeFiles": "{tests,docs,scripts,node_modules,frontend/src,frontend/node_modules}/**",
      "maxDuration": 30
    }
  }
}
