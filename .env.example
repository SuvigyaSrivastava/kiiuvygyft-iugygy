# Nothing here is required. Defaults work.
# Git commit shown in the app and in receipts (set by Docker build arg or Vercel).
GIT_COMMIT=
# Off by default. Turn on only on a machine you control, and set a token.
ENABLE_ADMIN_REFRESH=0
ADMIN_TOKEN=
# Override where the snapshot is read from.
# RAW_DIR=data/raw
# Frontend dev server only: point the browser at a different API origin.
# VITE_API_BASE=
